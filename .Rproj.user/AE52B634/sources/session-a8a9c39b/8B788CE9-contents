```{r, results='asis', echo=FALSE}
library(gt)

data <- read.table("/cloud/project/example.csv",
                   sep = ",", comment.char = "#", header = TRUE)

gt_table <- data |>
  gt() |>
  fmt_number(columns = 2:5, decimals = 1) |>
  tab_spanner(columns = 2:5, label = "Range")|>
  tab_caption(gt::md("Changes of air temperature. \\label{tbl}")) |>
  tab_options(table.width = gt::pct(100))

cat(gt::as_latex(gt_table))
```

