  pdf:
    pdf-engine: xelatex
    include-in-header: |
      \usepackage{caption}             % 念のため
      \renewcommand{\tablename}{Tab}  % ← 表の見出し
      \renewcommand{\figurename}{Figure} % ← 図の見出し(必要なら)

