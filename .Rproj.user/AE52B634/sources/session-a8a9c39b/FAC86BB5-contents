library(gt)
data <- read.table("/cloud/project/example.csv",sep=",", comment.char="#", header=T) 

gt_table <- data |> 
  gt() |>
  tab_spanner(columns = 4:5, label = "Range") |>
  fmt_number(columns = 2:5, decimals = 3) 

gtsave(gt_table, "my_table.tex")


latexmk("my_table.tex", engine = "lualatex", clean = FALSE)
