# 空気熱源式と地下水熱源式HPの消費電力量，熱量，COPを計算したrdsを読み込み，毎時のグラフを作成する
# パッケージ読み込み
library(ggplot2)
library(tidyr)
library(dplyr)
library(legendry)
library(scales)
library(crayon)
library(hms)
library(lubridate)
library(readr)




# ひな形を読み込み
source("source/Theme_Box_line.R")

tz_use <- "Asia/Tokyo"

# rdsファイルの読み込み
# RDS から温度データを読み込み
data_rds <- readRDS("/cloud/project/data/rds/COP_EC_Heat_20250817_0910.rds")
Heat <- data_rds$data # データ部分のみを取り出す

# 表示範囲指定
from <- as.POSIXct("2025-08-19 00:00:00", tz = tz_use)
to <- as.POSIXct("2025-09-10 23:59:00", tz = tz_use)

# データの整形# データをlong形式に変換（ggplotで扱いやすくするため）
df_long <- Heat %>%
  select(
    Time_stamp,
    Date,
    Hours,
    Air_hp_kWh,
    Water_hp_kWh,
    Delta_A_EC_kWh,
    Delta_W_EC_kWh,
    A_Heat_kW,
    W_Heat_kW,
    COP_A,
    COP_W
  ) %>%
  pivot_longer(
    cols = -c("Time_stamp", "Date", "Hours"),
    names_to = "Type",
    values_to = "Value"
  )

# 同じ日の2本目以降は日付を空欄にするラベラー
lab_date_time_once <- function(x, tz = tz_use) {
  d <- as.Date(x, tz = tz)
  first <- c(TRUE, d[-1] != d[-length(d)])
  paste0(ifelse(first, format(x, "%b-%d", tz = tz), "")) # ,
  # "\n",
  # format(x, "%k:%M", tz = tz) |> trimws())
}

breaks_h <- seq(from, to, by = "12 hours") # POSIXct

# 熱量のグラフ作成
select <- c("A_Heat_kW", "W_Heat_kW")
df_plot <- df_long %>%
  filter(Type %in% select, Hours >= 6, Hours <= 18)
df_plot <- df_plot %>%
  mutate(Type = recode(Type,
    "A_Heat_kW" = "Air HP",
    "W_Heat_kW" = "Water HP"
  ))

p1 <- df_plot %>%
  ggplot(aes(x = Time_stamp, y = Value, colour = Type, group = interaction(Date, Type))) +
  geom_line(stat = "identity", position = "identity", size = 0.6) +
  scale_color_manual(values = c("Air HP" = "darkblue", "Water HP" = "red")) +
  scale_x_datetime(
    limits = c(from, to),
    breaks = seq(from, to, by = "7 days"),
    minor_breaks = seq(from, to, by = "1 days"),
    labels = lab_date_time_once, # ← 二行表示＆同日まとめ
    name = "2025"
  ) +
  scale_y_continuous(
    limits = c(0, 5),
    breaks = seq(0, 5, 1),
    minor_breaks = seq(0, 5, 0.2),
    name = "Heat (kWh)"
  ) +
  theme_minimal() +
  # ひな形を指定
  Theme_Box_line(base_family = "latin-times") +

  # オプションのみ指定

  theme(
    legend.justification = c("right", "top"),
    legend.position = c(1, 1),
    legend.direction = "horizontal",
    # legend.direction = "vertical",
    legend.box.margin = margin(t = 10, r = 10, b = 6, l = 6, unit = "pt")
  )
p1
# # 画像ファイルとして保存
ggsave("/cloud/project/figs/Fig_Heat_hours.pdf",
  plot = p1,
  width = 15,
  height = 10, units = "cm",
  device = cairo_pdf
)

