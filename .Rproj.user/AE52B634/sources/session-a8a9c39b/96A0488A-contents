# どの .Rprofile が存在しているか
paths <- c(
  site    = file.path(R.home("etc"), "Rprofile.site"),
  user    = path.expand("~/.Rprofile"),
  project = file.path(getwd(), ".Rprofile")
)
exists <- file.exists(paths)
print(data.frame(path = paths, exists))

# 読み込まれた .Rprofile の中身（存在するものだけ表示）
for (p in paths[exists]) {
  cat("\n--- ", p, " ---\n", sep = ""); print(readLines(p, warn = FALSE))
}

# renv がロード／有効かを確認
"renv" %in% loadedNamespaces()
"package:renv" %in% search()
try(renv::status(), silent = TRUE)

# プロジェクト直下の状況
list.files(getwd(), all.files = TRUE)

# 念のため：親ディレクトリに renv.lock がいないか
list.files("..", pattern = "renv.lock", all.files = TRUE)
